# Copy to .env next to docker-compose.yml and fill in what you use.
# Compose reads this file automatically; nothing here is required to boot.

# The API password. On a server: set this — compose disables loopback trust, so
# without a password nothing (including you) can reach the API.
SNITCH_UI__PASSWORD=

# Copernicus Data Space credentials (optical catalogue). Without them the open
# Earth Search fallback is used.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional: vision-model explanations (explanations.vlm_enabled must also be true,
# and the endpoint must be https).
SNITCH_VLM_API_KEY=

# Optional: email notifications (notifications.email.enabled + smtp settings).
SMTP_PASSWORD=

# Optional: Matrix notifications.
MATRIX_TOKEN=

# Optional: Google Earth Engine lane (adapters.gee.enabled + a project id).
# Paste the full service-account JSON on this single line.
GEE_SERVICE_ACCOUNT_JSON=
